"""Limite de solicitudes por IP en un solo proceso (demo local)."""
import asyncio
from collections import defaultdict, deque
from time import monotonic


class LocalRateLimiter:
    def __init__(self, per_minute: int = 8):
        self.per_minute = per_minute
        self._events = defaultdict(deque)
        self._lock = asyncio.Lock()
        self._last_cleanup = monotonic()

    async def allow(self, client_id: str) -> bool:
        now = monotonic()
        async with self._lock:
            if now - self._last_cleanup > 180:
                for key in list(self._events):
                    if not self._events[key] or self._events[key][-1] < now - 60:
                        self._events.pop(key, None)
                self._last_cleanup = now
            recent = self._events[client_id]
            while recent and recent[0] <= now - 60:
                recent.popleft()
            if len(recent) >= self.per_minute:
                return False
            recent.append(now)
            return True


limiter = LocalRateLimiter()
concurrency_slots = asyncio.Semaphore(3)
