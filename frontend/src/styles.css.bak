:root{font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;color:#142235;background:#f4f7fb;font-synthesis:none}
*{box-sizing:border-box}body{margin:0}.app{max-width:1400px;padding:25px 24px 60px;margin:auto}
.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}.brand{display:flex;gap:14px;align-items:center;color:#2563eb}
.brand h1{margin:0;color:#13243b;font-size:28px}.brand p{margin:2px 0;color:#64748b;font-size:13px}.pill{padding:10px 16px;border-radius:30px;background:#e0e7ff;color:#3730a3;font-size:12px;font-weight:700}
.panel{background:white;border:1px solid #e3eaf2;border-radius:16px;padding:20px;box-shadow:0 4px 22px #172e5010;margin-bottom:18px}
h2{margin:0 0 16px;font-size:19px}h3{margin:0 0 18px;font-size:17px}.question form{display:flex;align-items:stretch;gap:12px}
textarea{flex:1;resize:vertical;min-height:62px;border:1px solid #cbd5e1;border-radius:10px;padding:13px;font:inherit;outline-color:#2563eb}
button{background:#2563eb;color:white;border:0;border-radius:10px;padding:12px 20px;display:flex;gap:8px;align-items:center;justify-content:center;font-weight:700;cursor:pointer;white-space:nowrap}
button:disabled{opacity:.55;cursor:wait}.layout{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(350px,1fr);gap:18px}.layout aside{min-width:0}
.graph{height:700px;border-radius:12px;background:#fbfdff;border:1px solid #e3eaf2}.fine{color:#64748b;font-size:12px;line-height:1.5;margin-bottom:0}
table{width:100%;border-collapse:collapse;font-size:12px}th{text-align:left;color:#64748b}td,th{padding:10px 5px;border-bottom:1px solid #e2e8f0;word-break:break-word}
.total{display:flex;gap:10px;justify-content:space-between;font-size:12px;margin-top:16px}.total strong{color:#15803d}.log{max-height:300px;overflow:auto}
.logentry{padding:9px 0;border-bottom:1px solid #f1f5f9;font-size:12px;display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}.logentry strong{color:#1d4ed8}.time,.muted{color:#64748b}
.answer pre{white-space:pre-wrap;word-break:break-word;font-family:inherit;line-height:1.7;margin:0}.error{color:#b91c1c}
@media(max-width:1000px){.layout{grid-template-columns:1fr}}@media(max-width:650px){.question form{flex-direction:column}.pill{display:none}.app{padding:14px}.graph{height:560px}}
